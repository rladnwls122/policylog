{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vite/client"
    ],
    "lib": [
      "ES2022"
    ],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test"
  ]
}
