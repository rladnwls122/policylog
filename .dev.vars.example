# 로컬 wrangler dev 용. 이 파일을 .dev.vars 로 복사하고 값을 채운다. .dev.vars 는 커밋되지 않는다.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
ADMIN_PASSWORD=devpassword
# Google 로그인 (Google Cloud Console → OAuth 클라이언트 → 승인된 리디렉션 URI: http://localhost:8788/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
