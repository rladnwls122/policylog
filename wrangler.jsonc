{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "policylog",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 18 * * *"] },
  // Postgres via Hyperdrive. Create it once with
  //   npx wrangler hyperdrive create policylog --connection-string="$DATABASE_URL"
  // and paste the returned id here. Local dev connects directly with DATABASE_URL from .dev.vars (see .dev.vars.example),
  // or use `wrangler dev --remote` to go through Hyperdrive. Tests run on an in-memory D1 (vitest.config.ts), same migrations.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "policylog-raw" }
  ],
  // Browser Rendering (S85). Needed only for RENDER_REQUIRED documents; static fetch stays the default path.
  // Local dev needs `wrangler dev --remote`; the binding is unavailable on the Workers free plan.
  "browser": { "binding": "BROWSER" },
  "vars": {
    "SITE_URL": "https://policylog.example",
    "CONTACT_EMAIL": "contact@policylog.example",
    "USER_AGENT": "POLICYLOG/0.1 (+https://policylog.example/bot; contact@policylog.example)",
    // ENFORCE = skip documents robots.txt disallows. ADVISORY = record the verdict, do not gate on it (S24.4).
    // Both modes keep: one User-Agent, the request-interval caps, and any explicit `User-agent: POLICYLOG` refusal.
    "ROBOTS_MODE": "ADVISORY"
  }
}
