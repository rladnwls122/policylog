{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "policylog",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 18 * * *"] },
  // 운영 저장소는 Postgres 다 (src/sql.ts 는 DATABASE_URL → DB → HYPERDRIVE 순으로 고른다). 스키마는 `npm run db:migrate` 가 넣는다.
  // D1 로 되돌리려면 이 블록을 지우고 d1_databases 바인딩 DB 를 넣는다 — 같은 migrations/*.sql 이 두 엔진에 다 들어간다.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "c29f495061b84449a19a9032f9d68376" }
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "policylog-raw" }
  ],
  // Browser Rendering (S85). Needed only for RENDER_REQUIRED documents; static fetch stays the default path.
  // Local dev needs `wrangler dev --remote`; the binding is unavailable on the Workers free plan.
  "browser": { "binding": "BROWSER" },
  "vars": {
    "SITE_URL": "https://policylog.kryukihide2009.workers.dev",
    "CONTACT_EMAIL": "kryukihide2009@gmail.com",
    "USER_AGENT": "POLICYLOG/0.1 (+https://policylog.kryukihide2009.workers.dev/bot; kryukihide2009@gmail.com)",
    // ENFORCE = skip documents robots.txt disallows. ADVISORY = record the verdict, do not gate on it (S24.4).
    // Both modes keep: one User-Agent, the request-interval caps, and any explicit `User-agent: POLICYLOG` refusal.
    "ROBOTS_MODE": "ADVISORY",
    // Google login. Set the OAuth client id here and `wrangler secret put GOOGLE_CLIENT_SECRET`; both empty = email sign-up only.
    // Authorized redirect URI in Google Cloud Console: https://<your host>/auth/google/callback
    "GOOGLE_CLIENT_ID": "588833057037-g8iadr22tn10u17a09cal2p0o5hui6q1.apps.googleusercontent.com"
  }
}
